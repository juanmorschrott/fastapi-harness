[importlinter]
root_package = {{ config.package }}

[importlinter:contract:layers]
name = Layers per module
type = layers
containers =
{% for module in config.modules %}    {{ config.package }}.modules.{{ module }}
{% endfor %}layers =
    routers
    services
    repositories
exhaustive = true

[importlinter:contract:no-router-repository]
name = Routers cannot directly import repositories
type = forbidden
source_modules =
{% for module in config.modules %}    {{ config.package }}.modules.{{ module }}.routers
{% endfor %}forbidden_modules =
{% for module in config.modules %}    {{ config.package }}.modules.{{ module }}.repositories
{% endfor %}allow_indirect_imports = true
{% if config.modules | length > 1 %}
[importlinter:contract:independent-modules]
name = Feature modules are independent
type = independence
modules =
{% for module in config.modules %}    {{ config.package }}.modules.{{ module }}
{% endfor %}{% endif %}
{% if has_shared %}
[importlinter:contract:shared-independence]
name = Shared code does not depend on feature modules
type = forbidden
source_modules =
    {{ config.package }}.shared
forbidden_modules =
{% for module in config.modules %}    {{ config.package }}.modules.{{ module }}
{% endfor %}{% endif %}
